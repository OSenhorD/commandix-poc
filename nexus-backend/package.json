{
  "name": "nexus-backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "author": "David Marques",
  "description": "Nexus backend",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/OSenhorD/commandix-poc.git"
  },
  "bugs": {
    "url": "https://github.com/OSenhorD/commandix-poc/issues"
  },
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "npm@12.0.0",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "contract:emit": "prisma contract emit",
    "seed": "tsx src/prisma/seed.ts",
    "skills:sync": "prisma skills sync || exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/cli-engine": "^0.2.3",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "prisma": "^8.0.0-rc.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
